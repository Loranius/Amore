public/models/school_of_fish_reef.glb
__pycache__/

# Impeccable: нативний рушій (~20 МБ на платформу) лаунчер `scripts/impeccable`
# сам завантажує в кеш за закріпленою версією — у git йому не місце.
.claude/skills/impeccable/scripts/bin/
.github/skills/impeccable/scripts/bin/
# Особисті налаштування Claude Code (тут — хуки Impeccable), не для всіх сесій.
.claude/settings.local.json

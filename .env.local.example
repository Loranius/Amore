# Скопіювати у .env.local (не комітиться). Anon-ключ публічний, захист — через RLS.
VITE_SUPABASE_URL=https://ВАШ-ПРОЄКТ.supabase.co
VITE_SUPABASE_ANON_KEY=ВАШ-ANON-КЛЮЧ
VITE_TMDB_KEY=
VITE_MAPBOX_TOKEN=

# Godot Evolution Engine:
# disabled / порожньо — Three.js;
# preview — Godot opt-in preview;
# production — Godot із автоматичним Three.js fallback.
VITE_EVOLUTION_GODOT=disabled

# Production rollout 0–100. Один браузер отримує стабільний cohort bucket,
# тому не перемикається випадково між Godot і Three.js під час наступних входів.
# За відсутності змінної використовується 100.
VITE_EVOLUTION_GODOT_ROLLOUT=100

# Фізична діагностика не потребує env-змінної. На preview URL додати:
# ?godotDiagnostics=1

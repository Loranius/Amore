# Скопіювати у .env.local (не комітиться). Anon-ключ публічний, захист — через RLS.
VITE_SUPABASE_URL=https://ВАШ-ПРОЄКТ.supabase.co
VITE_SUPABASE_ANON_KEY=ВАШ-ANON-КЛЮЧ
VITE_TMDB_KEY=
VITE_MAPBOX_TOKEN=

# Godot Evolution Engine:
# disabled / порожньо — Three.js;
# preview — Godot opt-in preview без production release gate;
# production — Godot лише після Phase 14 release approval, Phase 15 manifest
# preflight і з автоматичним Three.js fallback.
VITE_EVOLUTION_GODOT=disabled

# Бажаний rollout 0–100. Phase 14 додатково обмежує його release stage.
VITE_EVOLUTION_GODOT_ROLLOUT=100

# Production release gate. За замовчуванням blocked, тому одного
# VITE_EVOLUTION_GODOT=production недостатньо для ввімкнення Godot.
# Дозволені сходинки: blocked / canary-5 / ramp-25 / ramp-50 / released-100.
VITE_EVOLUTION_GODOT_RELEASE_STAGE=blocked

# Release ID: 3–64 символи, латиниця/цифри/крапка/дефіс/підкреслення.
# Phase 15 використовує його також для окремого Workbox cache namespace.
VITE_EVOLUTION_GODOT_RELEASE_ID=

# SHA-256 точних bytes frozen JSON зі статусом PHYSICAL PASS.
# Phase 15 release-manifest.json має містити цей самий digest.
VITE_EVOLUTION_GODOT_ACCEPTANCE_SHA256=

# on/true/1/kill миттєво закриває production gate і повертає Three.js.
VITE_EVOLUTION_GODOT_KILL_SWITCH=off

# Фізична діагностика на deployed preview:
# ?godotDiagnostics=1
# Після PHYSICAL PASS натиснути «Зафіксувати release candidate» — панель
# сформує digest і готовий canary env-блок для першого 5% rollout.

# Phase 15 operator console та локальний rollback proof:
# ?godotReleaseOps=1
# ?godotRollbackDrill=1
# Rollback drill діє лише для поточного браузерного URL, не змінює env,
# canonical state, Artifact DNA чи Evolution Events.
